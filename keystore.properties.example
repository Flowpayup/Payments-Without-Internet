# Release-signing configuration template.
#
# Copy this file to "keystore.properties" (which is gitignored) and fill in
# your real values. Never commit keystore.properties or the .jks keystore —
# they contain the private signing material for your release builds.
#
#   cp keystore.properties.example keystore.properties
#
# Then build a signed release APK with:
#
#   ./gradlew assembleRelease
#
# Absolute path to your release keystore (.jks). Generate one with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias flowpay
storeFile=/absolute/path/to/release.jks
storePassword=your-keystore-password
keyAlias=flowpay
keyPassword=your-key-password
