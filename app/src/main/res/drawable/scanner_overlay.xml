<?xml version="1.0" encoding="utf-8"?>
<!-- QR scanner corner bracket overlay — 4 L-shaped corners, no full border -->
<!-- Frame is 260x260dp; corner brackets are 32dp long, 3dp thick, white -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top-left: horizontal -->
    <item android:left="0dp" android:right="228dp" android:top="0dp" android:bottom="257dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="3dp" />
        </shape>
    </item>
    <!-- Top-left: vertical -->
    <item android:left="0dp" android:right="257dp" android:top="0dp" android:bottom="228dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="3dp" />
