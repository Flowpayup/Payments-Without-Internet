<?xml version="1.0" encoding="utf-8"?>
<!-- Solid white ring, tinted per NON-SUCCESS payment outcome at runtime
     (PaymentResultActivity): red failure, amber review, grey unverified.
     Ring shape matches circle_success_bg's seal motif — every outcome
     reads as a stamped mark, not just the success state.
     useLevel="false": see circle_success_bg.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="1.36"
    android:thicknessRatio="4.3"
    android:useLevel="false">
    <solid android:color="@android:color/white" />
</shape>
