<?xml version="1.0" encoding="utf-8"?>
<!-- Solid white oval, tinted per NON-SUCCESS payment outcome at runtime
     (PaymentResultActivity): red failure, amber review, grey unverified.
     Success keeps the brand-blue gradient (circle_success_bg) instead of a
     flat tint. -->
