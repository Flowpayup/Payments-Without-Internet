<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action on the payment result screen. A bordered rectangular
     record (ledger system: roundness reserved for status/seal badges only),
     not a gradient pill — the outcome is conveyed by the ring/heading/amount
     above; this button stays a plain, quiet action across every outcome.
     Kept a transparent fill (rather than a filled ink button) specifically
     so the existing white button text needs no companion change. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/flowpay_ink_warm" />
</shape>
