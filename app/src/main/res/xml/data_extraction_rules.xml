<?xml version="1.0" encoding="utf-8"?><!--
   Flowpay privacy rule (API 31+): transaction history and payment-operation
   state are excluded from both Google cloud backup and device-to-device
   transfer. See backup_rules.xml for the pre-API-31 equivalent.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="flowpay_database" />
        <exclude domain="database" path="flowpay_database-shm" />
        <exclude domain="database" path="flowpay_database-wal" />
        <exclude domain="sharedpref" path="payment_operation.xml" />
        <exclude domain="sharedpref" path="flowpay_db_key.xml" />
        <exclude domain="sharedpref" path="FlowpayPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="flowpay_database" />
        <exclude domain="database" path="flowpay_database-shm" />
        <exclude domain="database" path="flowpay_database-wal" />
        <exclude domain="sharedpref" path="payment_operation.xml" />
        <exclude domain="sharedpref" path="flowpay_db_key.xml" />
        <exclude domain="sharedpref" path="FlowpayPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
