<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions for UPI123 payment system -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Lets the in-call overlay's "End call" button actually hang up via TelecomManager.endCall() -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- CAMERA: phone camera for QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- SMS detection via BroadcastReceiver. READ_SMS is deliberately NOT
         requested: the app never reads the SMS inbox, it only receives
         incoming messages while a payment operation is active. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera features for QR code scanning -->
    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <application
        android:name=".FlowpayApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flowpay"
        tools:targetApi="31">

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Flowpay" />
        <activity
            android:name=".TestConfigurationActivity"
            android:exported="false"
            android:theme="@style/Theme.Flowpay" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Flowpay.Splash"
            android:label="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR Scanner Activity -->
        <activity
            android:name=".features.qr_scanner.presentation.QRScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.Flowpay"
            android:screenOrientation="portrait" />
        
        <!-- Payment Success Activity -->
        <activity
            android:name=".ui.activities.PaymentResultActivity"
            android:exported="false"
            android:theme="@style/PaymentSuccessTheme"
            android:screenOrientation="portrait"
            android:launchMode="singleTask" />
        
        <!-- Transaction History Activity -->
        <activity
            android:name=".ui.activities.TransactionHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Flowpay"
            android:screenOrientation="portrait" />
        
        <!-- Settings Activity -->
        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Flowpay"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        
        <!-- Call Overlay Service for UPI call protection -->
        <service
            android:name=".services.CallOverlayService"
            android:enabled="true"
            android:exported="false" />

        <!-- Notification Listener Service — opt-in fallback SMS detection -->
        <service
            android:name=".services.FlowpayNotificationListener"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SMS BroadcastReceiver — primary SMS transaction detection -->
        <receiver
            android:name=".receivers.SimpleSMSReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
