root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_kotlin_imports_layout = *
ij_kotlin_packages_to_use_import_on_demand = unset

[*.xml]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
