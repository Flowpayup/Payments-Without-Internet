root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_kotlin_imports_layout = *
# Wildcard imports are banned everywhere EXCEPT Compose's DSL packages, where
# a single screen legitimately pulls dozens of symbols from each and the
# ecosystem imports them wholesale. Mirrored by the WildcardImport excludes in
# app/config/detekt/detekt.yml; this property is what ktlint's
# NoWildcardImports rule reads.
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.foundation.**, androidx.compose.foundation.layout.**, androidx.compose.material3.**, androidx.compose.runtime.**, androidx.compose.animation.core.**, androidx.compose.material.icons.filled.**

[*.xml]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
